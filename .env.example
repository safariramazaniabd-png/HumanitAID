# ═══════════════════════════════════════
# HumanitAID — Environment Variables
# Copy to .env and fill in values
# NEVER commit .env to version control
# ═══════════════════════════════════════

# ── Server ──────────────────────────────
PORT=3000
NODE_ENV=development

# ── Database (PostgreSQL) ──────────────
# Production: hébergé sur Supabase (simple hôte PostgreSQL).
#   DATABASE_URL : connexion poolée (transaction pooler) → utilisé par les fonctions serverless Vercel
#   DIRECT_URL    : connexion directe (session mode)      → pour migrations / psql
# Inclure ?sslmode=require dans les deux (Supabase l'exige).
# Exemple Supabase : postgresql://postgres.XXXX:[password]@aws-0-eu.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=postgresql://user:password@localhost:5432/humanitaid
DIRECT_URL=postgresql://user:password@localhost:5432/humanitaid

# ── JWT Authentication ─────────────────
# REQUIRED in production — min 32 characters
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=TODO:CONFIGURE_A_STRONG_RANDOM_SECRET
JWT_EXPIRES_IN=7d

# ── Demo Mode ──────────────────────────
# Set to "false" in production — server will refuse to start if true
DEMO_MODE=true

# ── CORS ───────────────────────────────
# Comma-separated origins allowed
CORS_ORIGIN=http://localhost:8080

# ── Site URLs ──────────────────────────
SITE_URL=http://localhost:8080
ADMIN_URL=http://localhost:8080/admin

# ── Stripe (International Payments) ────
# MODE TEST (point 4) — utiliser UNIQUEMENT des clés TEST (sk_test_ / pk_test_).
# Les clés LIVE (sk_live_ / pk_live_) sont REJETÉES par l'API tant que le
# passage en production (point 10) n'est pas validé.
# Get test keys at: https://dashboard.stripe.com/test/apikeys
# STRIPE_SECRET_KEY      : server-only, ne jamais l'exposer au frontend
# STRIPE_PUBLISHABLE_KEY : publique, servie au frontend via GET /api/config/public
# STRIPE_WEBHOOK_SECRET  : secret whsec_... du endpoint webhook Vercel
#                          → à définir dans le Dashboard Stripe (« Add endpoint ») :
#                          URL: https://www.humanit-aid.org/api/webhooks/stripe
#                          Événements : checkout.session.completed
# Cartes de test officielles Stripe :
#   4242 4242 4242 4242  → paiement accepté
#   4000 0000 0000 0002  → refusé
#   4000 0000 0000 9995  → fonds insuffisants
#   4000 0000 0000 0000  → expiration
# Toute date future / CVV 123 pour les cinq cartes.
STRIPE_SECRET_KEY=sk_test_TODO
STRIPE_PUBLISHABLE_KEY=pk_test_TODO
STRIPE_WEBHOOK_SECRET=whsec_TODO

# ── Flutterwave (African Mobile Money) ─
# Get keys at: https://dashboard.flutterwave.com
FLUTTERWAVE_SECRET_KEY=FWSECK_TODO
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TODO
FLUTTERWAVE_ENCRYPTION_KEY=FLWSECK_TODO

# ── Paystack (African Payments) ────────
# Get keys at: https://dashboard.paystack.com
PAYSTACK_SECRET_KEY=sk_TODO
PAYSTACK_PUBLIC_KEY=pk_TODO

# ── Email Service ──────────────────────
# Supported: SendGrid, Mailgun, or SMTP
EMAIL_PROVIDER=sendgrid
EMAIL_API_KEY=SG_TODO
EMAIL_FROM=noreply@humanit-aid.org
EMAIL_FROM_NAME=HumanitAID Foundation

# ── File Storage ───────────────────────
# Options: local, cloudinary, s3
STORAGE_PROVIDER=local
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Upload Limits ──────────────────────
UPLOAD_MAX_SIZE_MB=10

# ── Admin Default Account ──────────────
# Used only for initial database seeding
ADMIN_DEFAULT_EMAIL=admin@humanit-aid.org
ADMIN_DEFAULT_PASSWORD=TODO:CONFIGURE_A_STRONG_PASSWORD
