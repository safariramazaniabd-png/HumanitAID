diff --git a/database/migrations/002_posts_cause_relation_and_trash.sql b/database/migrations/002_posts_cause_relation_and_trash.sql
new file mode 100644
index 0000000..6307309
--- /dev/null
+++ b/database/migrations/002_posts_cause_relation_and_trash.sql
@@ -0,0 +1,22 @@
+-- ════════════════════════════════════════════════════════════════════
+-- HUMANITAID — Migration 002 : Relation Publication → Cause + Corbeille
+--
+-- Application : PostgreSQL (Supabase) — idempotente, peut être relancée.
+--   psql "$DATABASE_URL" -f database/migrations/002_posts_cause_relation_and_trash.sql
+--
+-- Contexte : le CMS admin doit pouvoir rattacher une publication à l'une
+-- des 5 causes officielles (posts.cause_id), et une suppression doit
+-- rester récupérable (posts.deleted_at) plutôt que définitive, comme
+-- décrit dans HUMANITAID_NOUVELLES_FONCTIONNALITES.md §2.2 / §2.3 / §3.4.
+-- ════════════════════════════════════════════════════════════════════
+
+-- 1. Relation publication → cause (une cause peut avoir plusieurs publications).
+ALTER TABLE posts ADD COLUMN IF NOT EXISTS cause_id UUID REFERENCES causes(id) ON DELETE SET NULL;
+
+CREATE INDEX IF NOT EXISTS idx_posts_cause_id ON posts (cause_id);
+
+-- 2. Corbeille (soft-delete) : une publication supprimée reste en base,
+--    récupérable, et n'apparaît plus dans les listes publiques/admin par défaut.
+ALTER TABLE posts ADD COLUMN IF NOT EXISTS deleted_at TIMESTAMPTZ;
+
+CREATE INDEX IF NOT EXISTS idx_posts_deleted_at ON posts (deleted_at);
